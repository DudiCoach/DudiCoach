{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/engineering-policy.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git fetch*": "allow",
      "git remote -v*": "allow",
      "git remote get-url*": "allow",
      "git rev-parse*": "allow",
      "git rev-list*": "allow",
      "git merge-base*": "allow",
      "git ls-tree*": "allow",
      "git ls-files*": "allow",
      "git branch": "allow",
      "git branch -vv*": "allow",
      "git branch -r*": "allow",
      "git branch -a*": "allow",
      "git stash list*": "allow",
      "git worktree list*": "allow",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny"
    }
  },
  "agent": {
    "tester": {
      "description": "Writes and runs tests only. Restricted to tests/** and qa/**.",
      "mode": "subagent",
      "permission": {
        "edit": {
          "tests/**": "allow",
          "qa/**": "allow",
          "*": "deny"
        },
        "bash": {
          "*": "ask",
          "npx vitest*": "allow",
          "npx playwright*": "allow",
          "npm run lint*": "allow",
          "npm run typecheck*": "allow",
          "npm run build*": "allow"
        }
      }
    }
  }
}